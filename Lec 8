// HW Q2
#include <iostream>
using namespace std;

int main() {
    int a,b;
    char op;
    cout<<"enter 1st number and 2nd number"<<endl;
    cin>>a>>b;
    cout<<"enter operation to perform"<<endl;
    cin>>op;
    switch (op)
    {
    case '+':
        cout<<a+b<<endl;
        break;
        case '-':
        cout<<a-b<<endl;
        break;
        case '*':
        cout<<a*b<<endl;
        break;
        case '/':
        cout<<a/b<<endl;
        break;
        case '%':
        cout<<a%b<<endl;
        break;
    
    default:
        cout<<"invalid operation";
        break;
    }
    return 0;
}
